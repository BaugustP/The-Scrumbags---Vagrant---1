// Waits for echo to go HIGH then LOW, returns pulse width in microseconds
// (0 if it times out, meaning "no echo" / out of range).
static uint32_t measure_echo_pulse(volatile uint8_t *pin_reg, uint8_t bit) {
    uint32_t t0 = micros();
